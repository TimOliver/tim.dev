#!/usr/bin/env bash
#
# tim.dev - pre-commit hook
#
# Strips EXIF from any staged JPEG/PNG under Assets/ before the commit lands
# (added, copied, modified or renamed - a renamed photo is still a new file).
# Modified files are re-staged so the commit picks up the stripped versions.
# Scoped to Assets/, the only images that ship.
#
# Installed by Scripts/install-hooks.sh (symlink into .git/hooks/).
#
set -euo pipefail

# Preserve git's NUL separators, including filenames with spaces or newlines.
# Arrays/read -d work with the Bash 3.2 shipped by macOS.
staged=()
while IFS= read -r -d '' path; do
    case "$path" in
        Assets/*.[jJ][pP][gG]|Assets/*.[jJ][pP][eE][gG]|Assets/*.[pP][nN][gG])
            staged+=("$path") ;;
    esac
done < <(git diff --cached --name-only --diff-filter=ACMR -z)

if [[ ${#staged[@]} -eq 0 ]]; then
    exit 0
fi

# The hook strips the working-tree file and re-stages it, so an image with
# further unstaged edits would have those edits committed too. Refuse
# instead: stage (or stash) the image's final version first.
for path in "${staged[@]}"; do
    if ! git diff --quiet -- "$path"; then
        echo "pre-commit: $path has unstaged changes; stage or stash them, then commit again." >&2
        exit 1
    fi
done

count=${#staged[@]}
echo "pre-commit: stripping EXIF from $count staged image(s)..."

# The project virtualenv from Scripts/setup.sh has Pillow; fall back to the
# PATH's python3. set -e prevents re-staging or committing when any image
# fails processing.
python=python3
[[ -x .venv/bin/python ]] && python=.venv/bin/python
"$python" Scripts/strip-exif.py "${staged[@]}"
git add -- "${staged[@]}"
