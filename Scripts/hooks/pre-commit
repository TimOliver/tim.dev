#!/usr/bin/env bash
#
# tim.dev - pre-commit hook
#
# Strips EXIF from any staged JPEG/PNG under Assets/ before the commit lands
# (added, copied, modified or renamed - a renamed photo is still a new file).
# Modified files are re-staged so the commit picks up the stripped versions.
# Scoped to Assets/ specifically - Template/img/ contains hand-vetted mockup
# assets we don't want to re-process, and other dirs are out of scope.
#
# Installed by Scripts/install-hooks.sh (symlink into .git/hooks/).
#
set -euo pipefail

# Preserve git's NUL separators, including filenames with spaces or newlines.
# Arrays/read -d work with the Bash 3.2 shipped by macOS.
staged=()
while IFS= read -r -d '' path; do
    case "$path" in
        Assets/*.[jJ][pP][gG]|Assets/*.[jJ][pP][eE][gG]|Assets/*.[pP][nN][gG])
            staged+=("$path") ;;
    esac
done < <(git diff --cached --name-only --diff-filter=ACMR -z)

if [[ ${#staged[@]} -eq 0 ]]; then
    exit 0
fi

count=${#staged[@]}
echo "pre-commit: stripping EXIF from $count staged image(s)..."

# set -e prevents re-staging or committing when any image fails processing.
python3 Scripts/strip-exif.py "${staged[@]}"
git add -- "${staged[@]}"
